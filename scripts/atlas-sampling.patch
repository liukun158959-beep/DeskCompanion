diff --git a/atlas/llm/base.py b/atlas/llm/base.py
index 2ad8f5f..893af9c 100644
--- a/atlas/llm/base.py
+++ b/atlas/llm/base.py
@@ -46,0 +47,3 @@ class LLM:
+        # 由调用方在这一轮 chat 前设置。None 表示不附加采样和思考字段。
+        self.sampling: dict[str, Any] | None = None
+        self.on_reasoning: Any | None = None
@@ -60,0 +64,3 @@ class LLM:
+                ``sampling`` 含 temperature、top_p、reasoning_effort 时，
+                另把 thinking.type=enabled 放进 extra_body。
+                reasoning_content 只回调 ``on_reasoning``，不写入 message。
@@ -71,0 +78 @@ class LLM:
+        kwargs.update(self._sampling_kwargs())
@@ -112 +119,4 @@ class LLM:
-            piece = getattr(delta, "content", None)
+            reasoning = _delta_text(delta, "reasoning_content")
+            if reasoning and self.on_reasoning is not None:
+                self.on_reasoning(reasoning)
+            piece = _delta_text(delta, "content")
@@ -141,0 +152,26 @@ class LLM:
+
+    def _sampling_kwargs(self) -> dict[str, Any]:
+        raw = self.sampling
+        if not raw:
+            return {}
+        return {
+            "temperature": raw["temperature"],
+            "top_p": raw["top_p"],
+            "extra_body": {
+                "thinking": {"type": "enabled"},
+                "reasoning_effort": raw["reasoning_effort"],
+            },
+        }
+
+
+def _delta_text(delta: Any, key: str) -> str | None:
+    # 已知字段在属性上；协议外的 reasoning_content 在 model_extra。
+    direct = getattr(delta, key, None)
+    if isinstance(direct, str) and direct:
+        return direct
+    extra = getattr(delta, "model_extra", None)
+    if isinstance(extra, dict):
+        value = extra.get(key)
+        if isinstance(value, str) and value:
+            return value
+    return None
